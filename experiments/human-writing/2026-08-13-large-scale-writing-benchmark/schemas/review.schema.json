{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/idaibin/ai-handbook/schemas/human-writing-review-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "wave_id", "scope", "family_id", "reviewed_case_ids", "skill_revision", "failure_cases", "root_causes", "decision", "review_sha256"],
  "properties": {
    "schema_version": {"const": "review/v2"},
    "batch_id": {"type": "string", "minLength": 1},
    "wave_id": {"type": "string", "pattern": "^(D|H)(0[1-8])$"},
    "scope": {"enum": ["family_slice", "global_wave"]},
    "family_id": {"type": ["string", "null"], "pattern": "^F(0[1-9]|1[0-2])$"},
    "reviewed_case_ids": {
      "type": "array", "items": {"type": "string"}, "uniqueItems": true
    },
    "skill_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "failure_cases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "root_causes": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["tag", "evidence", "recurrence"],
        "properties": {
          "tag": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "recurrence": {"type": "integer", "minimum": 1}
        }
      }
    },
    "decision": {"enum": ["no_change", "candidate", "accepted", "reverted", "blocked"]},
    "proposed_change": {"type": ["string", "null"]},
    "counterexample": {"type": ["string", "null"]},
    "next_revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
