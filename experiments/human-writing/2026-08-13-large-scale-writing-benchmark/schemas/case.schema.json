{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/idaibin/ai-handbook/schemas/human-writing-case-v2.json",
  "title": "Human writing benchmark case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "case_id", "family_id", "split", "batch", "language",
    "operation", "output_form", "audience", "length_contract", "risk_level",
    "prompt", "source", "atomic_claims", "evidence", "permitted_omissions",
    "gates", "no_op_policy", "constraints", "criteria",
    "provenance", "case_sha256"
  ],
  "properties": {
    "schema_version": {"const": "case/v2"},
    "case_id": {"type": "string", "pattern": "^F(0[1-9]|1[0-2])-(D(0[1-9]|[1-7][0-9]|80)|H(0[1-9]|1[0-9]|20))$"},
    "family_id": {"type": "string", "pattern": "^F(0[1-9]|1[0-2])$"},
    "split": {"enum": ["development", "holdout"]},
    "batch": {"type": "integer", "minimum": 1, "maximum": 8},
    "language": {"enum": ["zh", "en"]},
    "operation": {"enum": ["draft", "rewrite", "summarize", "adapt", "proofread", "structure"]},
    "output_form": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "length_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["unit", "minimum", "maximum", "source"],
      "properties": {
        "unit": {"enum": ["chars", "words", "tokens", "unspecified"]},
        "minimum": {"type": ["integer", "null"], "minimum": 0},
        "maximum": {"type": ["integer", "null"], "minimum": 1},
        "source": {"enum": ["explicit", "unspecified"]}
      }
    },
    "risk_level": {"enum": ["low", "medium", "high"]},
    "prompt": {"type": "string", "minLength": 1},
    "source": {"type": ["string", "null"]},
    "atomic_claims": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim_id", "text", "evidence_ids", "required"],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "required": {"type": "boolean"}
        }
      }
    },
    "evidence": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "kind", "text", "source_span_sha256"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["task_brief", "source_text", "explicit_constraint"]},
          "text": {"type": "string", "minLength": 1},
          "source_span_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "permitted_omissions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "gates": {
      "type": "array", "minItems": 1, "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gate_id", "gate_type", "target", "expected"],
        "properties": {
          "gate_id": {"type": "string", "minLength": 1},
          "gate_type": {"enum": ["contains", "not_contains", "length", "grounding", "format", "no_op"]},
          "target": {"type": "string", "minLength": 1},
          "expected": {"type": ["string", "integer", "boolean"]}
        }
      }
    },
    "no_op_policy": {"enum": ["forbidden", "allowed", "required"]},
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protected", "required_fields", "forbidden_additions"],
      "properties": {
        "protected": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "forbidden_additions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "min_chars": {"type": ["integer", "null"], "minimum": 0},
        "max_chars": {"type": ["integer", "null"], "minimum": 1},
        "exact_noop": {"type": "boolean", "default": false}
      }
    },
    "criteria": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion_id", "text", "weight"],
        "properties": {
          "criterion_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "weight": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "revision", "license", "locator", "content_sha256", "redistribution", "source_lock_sha256"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "redistribution": {"enum": ["allowed", "locator_only", "review_required"]}
        ,"source_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "case_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
